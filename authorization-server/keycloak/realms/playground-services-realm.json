{
  "realm": "playground-services",
  "displayName": "Playground Services (machine-to-machine)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 3600,
  "clientSessionIdleTimeout": 0,
  "clientSessionMaxLifespan": 0,
  "clientScopes": [
    {
      "name": "credentials:read",
      "description": "Read credential records, including password hashes. Granted to exactly one client in this realm.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "user-data-master-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "user-data-master",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "customer:read",
      "description": "Read person attributes from the user data master.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "user-data-master-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "user-data-master",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "customer:write",
      "description": "Create and update person attributes in the user data master. Unused until Phase 2.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "user-data-master-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "user-data-master",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "user-data-master",
      "name": "User Data Master (audience only)",
      "description": "Registered so tokens can name it in aud. Not a caller: every flow is disabled and it has no service account. It exists in this registry purely so 'who is this token for' has an answer that points at a real entry.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": [],
      "optionalClientScopes": []
    },
    {
      "clientId": "idp-server",
      "name": "IdP Server",
      "description": "The only client in this realm holding credentials:read. That single fact is the point of splitting this realm out — 'only the IdP may see password hashes' becomes config rather than convention.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "idp-server-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": false,
      "attributes": {
        "use.refresh.tokens": "false",
        "client_credentials.use_refresh_token": "false"
      },
      "defaultClientScopes": [
        "basic",
        "credentials:read",
        "customer:read"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "resource-backend",
      "name": "Resource Backend",
      "description": "Registered now, unused until Phase 2. Costs nothing and keeps every realm-JSON edit in one commit.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "resource-backend-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": false,
      "attributes": {
        "use.refresh.tokens": "false",
        "client_credentials.use_refresh_token": "false"
      },
      "defaultClientScopes": [
        "basic",
        "customer:read",
        "customer:write"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "kc-enricher",
      "name": "Keycloak Enricher",
      "description": "Phase 2. The Keycloak authenticator that pulls customer status into brokered logins. Read-only by design.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "kc-enricher-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": false,
      "attributes": {
        "use.refresh.tokens": "false",
        "client_credentials.use_refresh_token": "false"
      },
      "defaultClientScopes": [
        "basic",
        "customer:read"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": []
}
